# Copy this file to .env and fill in your values.

# Which AI to use: gemini (free tier) or claude (paid API credits)
LLM_PROVIDER=gemini

# ---- Gemini (free) -------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Model to use first. If it is not available on your key, the app tries the fallbacks in order.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash-lite
# Seconds to wait for one Gemini answer, and for one whole generation step (including retries)
GEMINI_TIMEOUT=180
GEMINI_TOTAL_TIMEOUT=420

# ---- Claude (optional, needs API credits) --------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- General -------------------------------------------------------------
# Max output tokens per generation step (raise if you see a "cut off" error on very large BRDs)
MAX_OUTPUT_TOKENS=32000
# true = show a bundled sample playbook without calling any AI (quick UI check)
DEMO_MODE=false
PORT=5000
